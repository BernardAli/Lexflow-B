# Prototype data and configuration. DO NOT use the seeded accounts for real data.
LEXFLOW_SEED_DEMO=1
LEXFLOW_MAX_UPLOAD_MB=12
LEXFLOW_SECURE_COOKIES=0
LEXFLOW_SECURITY_PROFILE=demo
LEXFLOW_ALLOWED_HOSTS=localhost,127.0.0.1
LEXFLOW_IDLE_MINUTES=30
# Fictional, local TLS case-management destination; requires demo seeding.
LEXFLOW_DEMO_NOTARY=1
# Optional in demo; mandatory in the hardened profile.
# LEXFLOW_REQUIRE_MFA=1
# Keep external keys out of source control. Hardened deployments require them.
# LEXFLOW_AUDIT_KEY=32-or-more-random-characters
# LEXFLOW_MFA_KEY=a-separately-generated-Fernet-key
# LEXFLOW_STORAGE_KEYS='{"office-1":["a-Fernet-key-generated-with-cryptography"]}'
# Workspace webhook URLs must be HTTPS, with a 32+ character HMAC secret.
# LEXFLOW_WEBHOOK_TARGETS='{"office-1":{"url":"https://receiver.example.com/import","secret":"32-or-more-random-characters"}}'
# Demo mode shows reset links only for the four seeded synthetic accounts.
# Choose smtp for email delivery, or disabled to turn recovery off.
LEXFLOW_RESET_DELIVERY=demo
# SMTP requires an HTTPS public origin; reset links never use the request Host header.
# LEXFLOW_PUBLIC_URL=https://lexflow.example.com
# LEXFLOW_SMTP_HOST=smtp.example.com
# LEXFLOW_SMTP_PORT=587
# LEXFLOW_SMTP_SECURITY=starttls
# LEXFLOW_SMTP_FROM='LexFlow <noreply@example.com>'
# LEXFLOW_SMTP_USERNAME=
# LEXFLOW_SMTP_PASSWORD=
LEXFLOW_ALLOW_EXTERNAL_AI=0
# DO NOT enable external AI processing for confidential notary data without
# appropriate legal, contractual and regional data-processing controls.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# LEXFLOW_DATA_DIR=./data
